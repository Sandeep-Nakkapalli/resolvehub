DEBUG=True
SECRET_KEY=change-this-development-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 8 is the recommended development database.
DB_ENGINE=django.db.backends.mysql
DB_NAME=resolvehub
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to 1 only for local development when you intentionally need SQLite fallback.
USE_SQLITE=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@resolvehub.local
