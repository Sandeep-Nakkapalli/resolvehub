{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "django",
      "installCommand": "pip install -r requirements.txt",
      "buildCommand": "python manage.py collectstatic --noinput",
      "functions": {
        "backend/config/wsgi.py": {
          "maxDuration": 60
        }
      }
    },
    "backend": {
      "root": "backend",
      "runtime": "python",
      "entrypoint": "config.wsgi:application",
      "installCommand": "pip install -r requirements.txt",
      "functions": {
        "config/wsgi.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
